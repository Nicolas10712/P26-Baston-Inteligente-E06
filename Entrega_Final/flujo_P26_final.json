    "z": "15452b58949459b7",
    "name": "Armar comando P26",
    "func": "\nconst accion = msg.payload;\n\nif (accion !== \"ON\" && accion !== \"OFF\") {\n    return null;\n}\n\nmsg.topic = \"curso/E06/P26/Baston_E06/cmd\";\nmsg.payload = { cmd: accion };\nmsg.qos = 1;\nmsg.retain = false;\n\nreturn msg;\n",
