    "z": "15452b58949459b7",
    "name": "Interpretar estado FSM",
    "func": "\nconst estados = {\n    0: \"LIBRE\",\n    1: \"OBSTACULO_LEJOS\",\n    2: \"OBSTACULO_CERCA\",\n    3: \"ERROR_SENSOR\",\n    4: \"ACTUANDO_REMOTO\",\n    5: \"SIN_ECO\"\n};\n\nconst codigo = Number(msg.payload.estado_num);\n\nmsg.payload = estados[codigo] ?? \"ESTADO_DESCONOCIDO\";\n\nreturn msg;\n",
